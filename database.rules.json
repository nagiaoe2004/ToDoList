{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userEmails": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdByUserId", "groupId"]
    },
    "groups": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "userGroups": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "login_history": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["time"]
    }
  }
}
